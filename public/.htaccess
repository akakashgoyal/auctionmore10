# ==============================================================================
# Apache / LiteSpeed Rewrite Configuration for Single Page Application (SPA)
# Domain: https://auctionandmore.in / https://auctionsandmore.in
# Compatible with Hostinger hPanel, cPanel, and Apache/LiteSpeed web servers
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Handle CORS if needed
  Header always set Access-Control-Allow-Origin "*"

  # Prevent looping on the entry point
  RewriteRule ^index\.html$ - [L]

  # If the requested path exists as a physical file, serve it directly
  RewriteCond %{REQUEST_FILENAME} !-f
  # If the requested path exists as a physical directory, serve it directly
  RewriteCond %{REQUEST_FILENAME} !-d
  # If the requested path exists as a symlink, serve it directly
  RewriteCond %{REQUEST_FILENAME} !-l

  # Rewrite all internal SPA routes (/authority-properties, /property/*, etc.) to index.html
  RewriteRule . /index.html [L]
</IfModule>

# Fallback error handling: ensure 404s serve the SPA shell so React can render the 404 page
ErrorDocument 404 /index.html

# ==============================================================================
# Browser Caching & Performance Headers
# ==============================================================================
<IfModule mod_headers.c>
  # HTML files must never be aggressively cached so new app builds load immediately
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Cache hashed static assets (JS, CSS, images, fonts) for 1 year with immutable flag
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ==============================================================================
# Gzip / Brotli Compression
# ==============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
